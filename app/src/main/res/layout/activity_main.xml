<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- 1. Full Screen Camera Viewfinder -->
    <androidx.camera.view.PreviewView
        android:id="@+id/viewFinder"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvExtractedText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 2. Image Preview (when photo selected/captured) -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        android:scaleType="centerInside"
        android:background="#E0E0E0"
        android:contentDescription="Scanned Image Preview"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvExtractedText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 3. Bottom Control Bar Background -->
    <View
        android:id="@+id/bottomBar"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:background="#99000000"
        app:layout_constraintBottom_toTopOf="@id/tvExtractedText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 4. Bottom Left Gallery / Library Button -->
    <ImageButton
        android:id="@+id/btnGallery"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginStart="40dp"
        android:background="@drawable/rounded_button_bg"
        android:contentDescription="Open Gallery"
        android:scaleType="centerInside"
        android:src="@android:drawable/ic_menu_gallery"
        app:layout_constraintTop_toTopOf="@id/bottomBar"
        app:layout_constraintBottom_toBottomOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 5. Bottom Center Camera Shutter Click Button -->
    <ImageButton
        android:id="@+id/btnCapture"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:background="@drawable/circle_shutter_bg"
        android:contentDescription="Capture Photo"
        app:layout_constraintTop_toTopOf="@id/bottomBar"
        app:layout_constraintBottom_toBottomOf="@id/bottomBar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 6. Extracted Text Display -->
    <TextView
        android:id="@+id/tvExtractedText"
        android:layout_width="0dp"
        android:layout_height="180dp"
        android:padding="16dp"
        android:text="Extracted text will appear here..."
        android:textSize="16sp"
        android:textColor="@android:color/white"
        android:background="#222222"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
